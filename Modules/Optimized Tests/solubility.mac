    /* --- Sulfides --- */
%_SOLUBILITY_DB["CuS"] : [35.90, "Cu^{2+}",   1, "S^{2-}",  1]$
%_SOLUBILITY_DB["Cu2S"] : [47.60, "Cu^+",      2, "S^{2-}",  1]$
