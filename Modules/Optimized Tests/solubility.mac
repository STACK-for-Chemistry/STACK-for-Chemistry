%_SOLUBILITY_DB["Bi2S3"] : [97.00, "Bi^{3+}",   2, "S^{2-}",  3]$
%_SOLUBILITY_DB["SnS"] : [26.00, "Sn^{2+}",   1, "S^{2-}",  1]$
    /* --- Phosphates --- */
%_SOLUBILITY_DB["Ca3(PO4)2"] : [32.68, "Ca^{2+}",   3, "PO4^{3-}", 2]$
%_SOLUBILITY_DB["Ag3PO4"] : [16.05, "Ag^+",      3, "PO4^{3-}", 1]$
%_SOLUBILITY_DB["FePO4"] : [15.00, "Fe^{3+}",   1, "PO4^{3-}", 1]$
%_SOLUBILITY_DB["AlPO4"] : [20.01, "Al^{3+}",   1, "PO4^{3-}", 1]$
%_SOLUBILITY_DB["Pb3(PO4)2"] : [42.10, "Pb^{2+}",   3, "PO4^{3-}", 2]$
%_SOLUBILITY_DB["Zn3(PO4)2"] : [32.05, "Zn^{2+}",   3, "PO4^{3-}", 2]$
    /* --- Chromates --- */
%_SOLUBILITY_DB["BaCrO4"] : [9.93,  "Ba^{2+}",   1, "CrO4^{2-}", 1]$
%_SOLUBILITY_DB["PbCrO4"] : [12.55, "Pb^{2+}",   1, "CrO4^{2-}", 1]$
%_SOLUBILITY_DB["Ag2CrO4"] : [11.95, "Ag^+",      2, "CrO4^{2-}", 1]$
