%_SOLUBILITY_DB["CaCrO4"] : [3.15,  "Ca^{2+}",   1, "CrO4^{2-}", 1]$
    /* --- Oxalates --- */
%_SOLUBILITY_DB["CaC2O4"] : [8.63,  "Ca^{2+}",   1, "C2O4^{2-}", 1]$
