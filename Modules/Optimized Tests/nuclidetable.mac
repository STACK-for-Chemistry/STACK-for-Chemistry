/* Explicit id list in original data-file order (arrayinfo() on a hashed
   array does not guarantee insertion order, so the order is captured
   here literally to keep chem_nuc_all_ids() output unchanged). */
%_NUCLIDE_ALL_IDS : ["Neutron", "^{3}H", "^{6}He", "^{8}He", "^{8}Li", "^{9}Li", "^{11}Li", "^{7}Be", "^{10}Be", "^{11}Be", "^{12}Be", "^{14}Be", "^{8}B", "^{12}B", "^{13}B", "^{14}B", "^{15}B", "^{17}B", "^{19}B", "^{9}C", "^{10}C", "^{11}C", "^{14}C", "^{15}C", "^{16}C", "^{17}C", "^{18}C", "^{19}C", "^{20}C", "^{22}C", "^{12}N", "^{13}N", "^{16}N", "^{17}N", "^{18}N", "^{19}N", "^{20}N", "^{21}N", "^{22}N", "^{23}N", "^{24}N", "^{13}O", "^{14}O", "^{15}O", "^{19}O", "^{20}O", "^{21}O", "^{22}O", "^{23}O", "^{24}O", "^{26}O", "^{28}O", "^{17}F", "^{18}F", "^{20}F", "^{21}F", "^{22}F", "^{23}F", "^{24}F", "^{25}F", "^{26}F", "^{27}F", "^{29}F", "^{30}F", "^{17}Ne", "^{18}Ne", "^{19}Ne", "^{23}Ne", "^{24}Ne", "^{25}Ne", "^{26}Ne", "^{27}Ne", "^{28}Ne", "^{29}Ne", "^{30}Ne", "^{31}Ne", "^{32}Ne", "^{33}Ne", "^{20}Na", "^{21}Na", "^{22}Na", "^{24}Na", "^{25}Na", "^{26}Na", "^{27}Na", "^{28}Na", "^{29}Na", "^{30}Na", "^{31}Na", "^{32}Na", "^{33}Na", "^{34}Na", "^{35}Na", "^{19}Mg", "^{20}Mg", "^{21}Mg", "^{22}Mg", "^{23}Mg", "^{27}Mg", "^{28}Mg", "^{29}Mg", "^{30}Mg", "^{31}Mg", "^{32}Mg", "^{33}Mg", "^{34}Mg", "^{35}Mg", "^{36}Mg", "^{37}Mg", "^{38}Mg", "^{21}Al", "^{22}Al", "^{23}Al", "^{24}Al", "^{25}Al", "^{26}Al", "^{28}Al", "^{29}Al", "^{30}Al", "^{31}Al", "^{32}Al", "^{33}Al", "^{34}Al", "^{35}Al", "^{36}Al", "^{37}Al", "^{38}Al", "^{39}Al", "^{40}Al", "^{41}Al", "^{22}Si", "^{23}Si", "^{24}Si", "^{25}Si", "^{26}Si", "^{27}Si", "^{31}Si", "^{32}Si", "^{33}Si", "^{34}Si", "^{35}Si", "^{36}Si", "^{37}Si", "^{38}Si", "^{39}Si", "^{40}Si", "^{41}Si", "^{42}Si", "^{43}Si", "^{25}P", "^{26}P", "^{27}P", "^{28}P", "^{29}P", "^{30}P", "^{32}P", "^{33}P", "^{34}P", "^{35}P", "^{36}P", "^{37}P", "^{38}P", "^{39}P", "^{40}P", "^{41}P", "^{42}P", "^{43}P", "^{44}P", "^{45}P", "^{26}S", "^{27}S", "^{28}S", "^{29}S", "^{30}S", "^{31}S", "^{35}S", "^{37}S", "^{38}S", "^{39}S", "^{40}S", "^{41}S", "^{42}S", "^{43}S", "^{44}S", "^{45}S", "^{46}S", "^{29}Cl", "^{30}Cl", "^{31}Cl", "^{32}Cl", "^{33}Cl", "^{34}Cl", "^{36}Cl", "^{38}Cl", "^{39}Cl", "^{40}Cl", "^{41}Cl", "^{42}Cl", "^{43}Cl", "^{44}Cl", "^{45}Cl", "^{46}Cl", "^{47}Cl", "^{30}Ar", "^{31}Ar", "^{32}Ar", "^{33}Ar", "^{34}Ar", "^{35}Ar", "^{37}Ar", "^{39}Ar", "^{41}Ar", "^{42}Ar", "^{43}Ar", "^{44}Ar", "^{45}Ar", "^{46}Ar", "^{47}Ar", "^{48}Ar", "^{49}Ar", "^{50}Ar"]$


/****************************************************************/
/*                                                              */
/*  Nuclide Retrieval Functions    Modules/Tests/nuclidetable.mac                             */
/*                                                              */
/****************************************************************/

/* ---- Internal helpers ---- */

chem_nuc_get_entry(id) := block([d],
    d: chem_nuc_get_data(id),
    if is(d = false) then false else [id, d]
)$

/* Direct O(1) hashed-array lookup: %_NUCLIDE_DATA[id] replaces the former
   linear assoc() scan entirely. subvarp(...) detects an unresolved array
   reference, which Maxima returns whenever the key was never assigned
   (i.e. an unknown nuclide id), so this still safely yields false. */
chem_nuc_get_data(id) := block([d],
    d: %_NUCLIDE_DATA[id],
    if subvarp(d) then false else d
)$

chem_nuc_id_from_ZN(z, n) := block([sym],
    if is(z < 1) or is(n < 0) then return(false),
    sym: chem_element(z),
    if is(sym = false) then false
    else sconcat("^{", z + n, "}", sym)
)$

%_NUC_CACHE_BY_Z : []$
%_NUC_CACHE_BY_N : []$
%_NUC_CACHE_BY_A : []$
%_NUC_CACHE_BY_ZN : []$
%_NUC_CACHE_BY_DECAY_MODE : []$

/* ---- Lookup by Z, N, A ---- */

chem_nuc_by_Z(z) := block([results, cached, id, d],
    cached: assoc(z, %_NUC_CACHE_BY_Z),
    if not is(cached = false) then return(cached),
    results: [],
    for id in %_NUCLIDE_ALL_IDS do (
        d: %_NUCLIDE_DATA[id],
        if d[1] = z then
            results: cons(id, results)
    ),
    results: reverse(results),
    %_NUC_CACHE_BY_Z : cons([z, results], %_NUC_CACHE_BY_Z),
    results
)$

chem_nuc_by_N(n) := block([results, cached, id, d],
    cached: assoc(n, %_NUC_CACHE_BY_N),
    if not is(cached = false) then return(cached),
    results: [],
    for id in %_NUCLIDE_ALL_IDS do (
        d: %_NUCLIDE_DATA[id],
        if d[2] = n then
            results: cons(id, results)
    ),
    results: reverse(results),
    %_NUC_CACHE_BY_N : cons([n, results], %_NUC_CACHE_BY_N),
    results
)$

chem_nuc_by_A(a) := block([results, cached, id, d],
    cached: assoc(a, %_NUC_CACHE_BY_A),
    if not is(cached = false) then return(cached),
    results: [],
    for id in %_NUCLIDE_ALL_IDS do (
        d: %_NUCLIDE_DATA[id],
        if d[1] + d[2] = a then
            results: cons(id, results)
    ),
    results: reverse(results),
    %_NUC_CACHE_BY_A : cons([a, results], %_NUC_CACHE_BY_A),
    results
)$

chem_nuc_by_ZN(z, n) := block([results, key, cached, id, d],
    key: sconcat(z, "|", n),
    cached: assoc(key, %_NUC_CACHE_BY_ZN),
    if not is(cached = false) then return(cached),
    results: [],
    for id in %_NUCLIDE_ALL_IDS do (
        d: %_NUCLIDE_DATA[id],
        if d[1] = z and d[2] = n then
            results: cons(id, results)
    ),
    results: reverse(results),
    %_NUC_CACHE_BY_ZN : cons([key, results], %_NUC_CACHE_BY_ZN),
    results
)$

/* ---- Field extractors ---- */

chem_nuc_Z(id) := block([d],
    d: chem_nuc_get_data(id),
    if is(d = false) then false else d[1]
)$

chem_nuc_N(id) := block([d],
    d: chem_nuc_get_data(id),
    if is(d = false) then false else d[2]
)$

chem_nuc_A(id) := block([d],
    d: chem_nuc_get_data(id),
    if is(d = false) then false else d[1] + d[2]
)$

chem_nuc_levels(id) := block([d],
    d: chem_nuc_get_data(id),
    if is(d = false) then false else d[3]
)$

chem_nuc_halflives(id) := block([d],
    d: chem_nuc_get_data(id),
    if is(d = false) then false else d[4]
)$

chem_nuc_halflife_units(id) := block([d],
    d: chem_nuc_get_data(id),
    if is(d = false) then false else d[5]
)$

chem_nuc_decay_modes(id) := block([d],
    d: chem_nuc_get_data(id),
    if is(d = false) then false else d[6]
)$

chem_nuc_branching(id) := block([d],
    d: chem_nuc_get_data(id),
    if is(d = false) then false else d[7]
)$

/* ---- Ground-state convenience functions ---- */

chem_nuc_gs_halflife(id) := block([hl],
    hl: chem_nuc_halflives(id),
    if is(hl = false) then false else first(hl)
)$

chem_nuc_gs_halflife_unit(id) := block([u],
    u: chem_nuc_halflife_units(id),
    if is(u = false) then false else first(u)
)$

chem_nuc_gs_decay_modes(id) := block([dm],
    dm: chem_nuc_decay_modes(id),
    if is(dm = false) then false else first(dm)
)$

chem_nuc_gs_branching(id) := block([br],
    br: chem_nuc_branching(id),
    if is(br = false) then false else first(br)
)$

/* Unit conversion table for half-lives to seconds */
%_HALFLIFE_UNIT_FACTORS: [
    ["fs", 1e-15], ["ps", 1e-12], ["ns", 1e-9],  ["us", 1e-6],
    ["ms", 1e-3],  ["s",  1],      ["m",  60],    ["h",  3600],
    ["d",  86400],  ["y",  31557600]
]$

/* ---- Half-life unit conversion to seconds ---- */

chem_nuc_halflife_to_seconds(val, unit) := block([factor],
    if is(val = null) or is(unit = null) then return(false),
    if sequal(unit, "fs") then factor: 1e-15
    else if sequal(unit, "ps") then factor: 1e-12
    else if sequal(unit, "ns") then factor: 1e-9
    else if sequal(unit, "us") then factor: 1e-6
    else if sequal(unit, "ms") then factor: 1e-3
    else if sequal(unit, "s") then factor: 1
    else if sequal(unit, "m") then factor: 60
    else if sequal(unit, "h") then factor: 3600
    else if sequal(unit, "d") then factor: 86400
    else if sequal(unit, "y") then factor: 31557600
    else factor: false,
    if is(factor = false) then false else val * factor
)$

chem_nuc_gs_halflife_s(id) := block([hl, u],
    hl: chem_nuc_gs_halflife(id),
    u:  chem_nuc_gs_halflife_unit(id),
    if is(hl = false) or is(u = false) then false
    else chem_nuc_halflife_to_seconds(hl, u)
)$

/* ---- Filtering / searching ---- */

chem_nuc_with_decay_mode(mode) := block([results, dm, cached, id, d],
    cached: assoc(mode, %_NUC_CACHE_BY_DECAY_MODE),
    if not is(cached = false) then return(cached),
    results: [],
    for id in %_NUCLIDE_ALL_IDS do (
        d: %_NUCLIDE_DATA[id],
        dm: first(d[6]),
        if member(mode, dm) then
            results: cons(id, results)
    ),
    results: reverse(results),
    %_NUC_CACHE_BY_DECAY_MODE : cons([mode, results], %_NUC_CACHE_BY_DECAY_MODE),
    results
)$

chem_nuc_halflife_range(t_min, t_max) := block([results, hl_s, v, u, id, d],
    results: [],
    for id in %_NUCLIDE_ALL_IDS do (
        d: %_NUCLIDE_DATA[id],
        v: first(d[4]),
        u: first(d[5]),
        hl_s: chem_nuc_halflife_to_seconds(v, u),
        if hl_s # false and hl_s >= t_min and hl_s <= t_max then
            results: cons(id, results)
    ),
    reverse(results)
)$

chem_nuc_radioactive_isotopes(z) := chem_nuc_by_Z(z)$

chem_nuc_num_levels(id) := block([lvl],
    lvl: chem_nuc_levels(id),
    if is(lvl = false) then 0 else length(lvl)
)$

chem_nuc_exists(id) := chem_nuc_get_data(id) # false$

chem_nuc_all_ids() := %_NUCLIDE_ALL_IDS$

chem_nuc_gs_dominant_mode(id) := block([modes, ratios, best_mode, best_ratio, i],
    modes:  chem_nuc_gs_decay_modes(id),
    ratios: chem_nuc_gs_branching(id),
    if is(modes = false) or is(ratios = false) then return(false),
    best_mode: false,
    best_ratio: -1,
    for i: 1 thru length(modes) do (
        if not is(ratios[i] = null) then (
            if is(ratios[i] > best_ratio) then (
                best_ratio: ratios[i],
                best_mode:  modes[i]
            )
        )
    ),
    best_mode
)$

/* ---- Decay products ---- */

chem_nuc_alpha_product(id) := block([d],
    d: chem_nuc_get_data(id),
    if is(d = false) then false
    else chem_nuc_id_from_ZN(d[1] - 2, d[2] - 2)
)$

chem_nuc_beta_minus_product(id) := block([d],
    d: chem_nuc_get_data(id),
    if is(d = false) then false
    else chem_nuc_id_from_ZN(d[1] + 1, d[2] - 1)
)$

chem_nuc_beta_plus_product(id) := block([d],
    d: chem_nuc_get_data(id),
    if is(d = false) then false
    else chem_nuc_id_from_ZN(d[1] - 1, d[2] + 1)
)$

chem_nuc_decay_product(id, mode) := block([],
    if sequal(mode, "A") or sequal(mode, "ALPHA") then
        chem_nuc_alpha_product(id)
    else if sequal(mode, "B-") or sequal(mode, "BETA-") then
        chem_nuc_beta_minus_product(id)
    else if sequal(mode, "B+") or sequal(mode, "BETA+") then
        chem_nuc_beta_plus_product(id)
    else false
)$

/* ---- Ionization helpers ---- */

chem_nuc_parse_oxidation_charge(ox) := block([clean, chars, n, i, sign, charge_num],
    if is(ox = false) or is(ox = null) then return(false),
    clean: ssubst("", " ", ox),
    chars: charlist(clean),
    n: length(chars),
    if is(n = 0) then return(false),

    sign: 1,
    i: 1,
    if sequal(chars[i], "+") then (
        sign: 1,
        i: i + 1
    ) else if sequal(chars[i], "-") then (
        sign: -1,
        i: i + 1
    ),

    charge_num: 0,
    while i <= n and cgreaterp(chars[i], "/") and clessp(chars[i], ":") do (
        charge_num: charge_num * 10 + (cint(chars[i]) - 48),
        i: i + 1
    ),

    if is(charge_num = 0) then false
    else sign * charge_num
)$

chem_nuc_charge_string(charge) := block([],
    if is(charge > 0) then sconcat(charge, "+")
    else if is(charge < 0) then sconcat(-charge, "-")
    else "0"
)$

chem_nuc_symbol(id) := block([parsed],
    if is(id = false) or is(id = null) then return(false),
    parsed: chem_parse_formula(id),
    if is(parsed = false) or length(parsed) = 0 then false
    else first(first(parsed))
)$

chem_nuc_typical_charge(id) := block([d, sym, ox],
    d: chem_nuc_get_data(id),
    if is(d = false) then return(false),
    sym: chem_nuc_symbol(id),
    if is(sym = false) then return(false),
    ox: chem_data(sym, "OxidationStates"),
    chem_nuc_parse_oxidation_charge(ox)
)$

chem_nuc_ionize(id, charge) := block([d, z, n, sym],
    d: chem_nuc_get_data(id),
    if is(d = false) then return(false),
    z: d[1],
    n: d[2],
    sym: chem_nuc_symbol(id),
    if is(sym = false) then return(false),
    sconcat("^{", z + n, "}", sym, "^{", chem_nuc_charge_string(charge), "}")
)$

chem_nuc_ionize_typical(id) := block([q],
    q: chem_nuc_typical_charge(id),
    if is(q = false) then false else chem_nuc_ionize(id, q)
)$
